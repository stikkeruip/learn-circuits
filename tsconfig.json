{
  // Compiler options mirror circuitjs1/ts/tsconfig.json, because our engine
  // imports that source directly and it is type-checked as part of this program.
  "compilerOptions": {
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // tests/comparison/browser-script.ts is run directly by Node, which needs ".ts" in its imports.
    "allowImportingTsExtensions": true,
    "paths": {
      "circuitjs/*": ["./circuitjs1/ts/*"]
    }
  },
  "include": ["src", "tests", "vite.config.ts"]
}
